theorem seedA_length : seedA.length = 580 := by decide
theorem seedB_length : seedB.length = 92 := by decide
theorem seedA_charge : (seedA.map Row.charge).sum = 290 := by decide
theorem seedB_charge : (seedB.map Row.charge).sum = 46 := by decide

theorem seeds_basedOn : BasedOn alphabet7 7 selectedRows := by
  unfold BasedOn
  decide

theorem seedA_closed : ClosedTrail seedA := by
  unfold ClosedTrail CyclicallyCompatible Row.Compatible
  decide

theorem seedB_closed : ClosedTrail seedB := by
  unfold ClosedTrail CyclicallyCompatible Row.Compatible
  decide

theorem unusedBases_length : unusedBases.length = 48 := by decide

theorem accountingRows_length : accountingRows.length = 720 := by
  simp [accountingRows, selectedRows, seedA_length, seedB_length, unusedBases_length]

theorem accountingRows_basedOn : BasedOn alphabet7 7 accountingRows := by
  intro r hr
  rcases List.mem_append.mp hr with hs | hu
  · exact seeds_basedOn r hs
  · have h : BasedOn alphabet7 7 (unusedBases.map (fun x => (⟨x,7,7⟩ : Row Nat))) := by
      unfold BasedOn
      decide
    exact h r hu

theorem canonicalBases_length : canonicalBases.length = 720 := by decide

theorem canonicalPointers_length : canonicalPointers.length = 720 := by decide

theorem canonicalPointers_bounds : ∀ q ∈ canonicalPointers, q.1 < 720 ∧ q.2 < 7 := by decide

def pointer (i : Fin 720) : Nat × Nat :=
  canonicalPointers[i.val]'(by rw [canonicalPointers_length]; exact i.isLt)

theorem pointer_bounds (i : Fin 720) : (pointer i).1 < accountingRows.length ∧ (pointer i).2 < 7 := by
  rw [accountingRows_length]
  exact canonicalPointers_bounds _ (List.getElem_mem _)

def canonicalWitness (i : Fin 720) : Row Nat := accountingRows[(pointer i).1]'(pointer_bounds i).1

theorem canonicalWitness_mem (i : Fin 720) : canonicalWitness i ∈ accountingRows := List.getElem_mem _

theorem canonicalWitness_rotation : ∀ i : Fin 720,
    rot (canonicalWitness i).base (pointer i).2 =
      canonicalBases[i.val]'(by rw [canonicalBases_length]; exact i.isLt) := by decide

theorem cutOrder_groups : (cutOrder.map Prod.fst).Perm (List.range 52) := by decide

theorem cutOrder_bounds : ∀ q ∈ cutOrder, q.1 < groupLengths.length ∧
    q.2 < groupLengths[q.1]?.getD 0 := by decide

theorem overlaps_sum : overlaps.sum = 145 := by decide

theorem overlaps_bounds : ∀ h ∈ overlaps, 2 ≤ h ∧ h ≤ 5 := by decide

