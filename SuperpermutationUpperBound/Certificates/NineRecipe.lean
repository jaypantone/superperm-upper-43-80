/-! Finite data for the nine-symbol construction.
The 672 deficit digits and two starts reconstruct all selected literal rows.
Canonical block witnesses and the saved cut/overlap recipe are checked below.
The finite appendix binds the cut boundaries to the actual completed trails. -/
namespace SuperpermutationUpperBound.Certificates.NineRecipe
open Partition

def alphabet7 : List Nat := [0,1,2,3,4,5,6]

def fullStep : List Nat → List Nat
  | [a,b,c,d,e,f,g] => [b,c,d,e,f,a,g]
  | x => x

def shortStep : List Nat → List Nat
  | [a,b,c,d,e,f,g] => [g,a,b,c,d,f,e]
  | x => x

def walk (x : List Nat) : List Nat → List (Row Nat)
  | [] => []
  | d :: ds => ⟨x,7,7-d⟩ :: walk (if d = 2 then shortStep x else fullStep x) ds

