def mergeFuel {α : Type} (le : α → α → Bool) (fuel : Nat) (xs ys : List α) : List α :=
  match fuel, xs, ys with
  | 0, xs, ys => xs ++ ys
  | _+1, [], ys => ys
  | _+1, xs, [] => xs
  | k+1, x :: xs, y :: ys =>
    if le x y then x :: mergeFuel le k xs (y :: ys)
    else y :: mergeFuel le k (x :: xs) ys
termination_by structural fuel

theorem mergeFuel_perm {α : Type} (le : α → α → Bool) (fuel : Nat) (xs ys : List α) :
    (mergeFuel le fuel xs ys).Perm (xs ++ ys) := by
  induction fuel generalizing xs ys with
  | zero => exact .refl _
  | succ k ih =>
    cases xs with
    | nil => simp [mergeFuel]
    | cons x xs =>
      cases ys with
      | nil => simp [mergeFuel]
      | cons y ys =>
        simp only [mergeFuel]
        split
        · exact (ih xs (y :: ys)).cons x
        · exact ((ih (x :: xs) ys).cons y).trans
            ((List.Perm.swap x y _).trans (List.perm_middle.symm.cons x))

def sortFuel {α : Type} (le : α → α → Bool) (fuel : Nat) (xs : List α) : List α :=
  match fuel, xs with
  | 0, xs => xs
  | _+1, [] => []
  | _+1, [x] => [x]
  | k+1, x :: y :: xs =>
    let whole := x :: y :: xs
    mergeFuel le whole.length (sortFuel le k (whole.take (whole.length / 2)))
      (sortFuel le k (whole.drop (whole.length / 2)))
termination_by structural fuel

theorem sortFuel_perm {α : Type} (le : α → α → Bool) (k : Nat) (xs : List α) :
    (sortFuel le k xs).Perm xs := by
  induction k generalizing xs with
  | zero => exact .refl _
  | succ k ih =>
    cases xs with
    | nil => exact .refl _
    | cons x xs =>
      cases xs with
      | nil => exact .refl _
      | cons y xs =>
        unfold sortFuel
        exact (mergeFuel_perm ..).trans
          (((ih _).append (ih _)).trans (List.Perm.of_eq (List.take_append_drop ..)))


