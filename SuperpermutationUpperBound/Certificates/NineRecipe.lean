def completedFamily : List (Row Nat) :=
  Completion.packingRows selectedRows 8 ++ unusedBases.flatMap (fun x => fullChart x 7 8)

def rowKey (r : Row Nat) : Nat :=
  ((r.base.foldl (fun v a => 10 * v + a) 0) * 10 + r.satellite) * 10 + r.visible

def rowLE (r s : Row Nat) : Bool := decide (rowKey r ≤ rowKey s)

set_option maxRecDepth 100000
set_option maxHeartbeats 64000000

/-- Equality is checked on actual row lists; the numeric key only chooses
an order and needs no trusted injectivity assertion. -/
theorem recipeTrails_inventory_sorted :
    sortFuel rowLE 13 recipeTrails.flatten = sortFuel rowLE 13 completedFamily := by decide

theorem recipeTrails_inventory : recipeTrails.flatten.Perm completedFamily :=
  (sortFuel_perm rowLE 13 recipeTrails.flatten).symm.trans
    ((List.Perm.of_eq recipeTrails_inventory_sorted).trans (sortFuel_perm rowLE 13 completedFamily))

theorem recipeTrails_closed : ∀ rs ∈ recipeTrails, ClosedTrail rs := by
  unfold ClosedTrail CyclicallyCompatible Row.Compatible
  decide

theorem recipeTrails_valid : ∀ r ∈ recipeTrails.flatten,
    r.Valid ∧ r.base.length = 8 ∧ r.satellite < 9 ∧ (∀ a ∈ r.base, a < 9) := by decide

theorem recipeTrails_count : recipeTrails.length = 52 := by decide

theorem recipeTrails_row_count : recipeTrails.flatten.length = 5376 := by decide

theorem recipeTrails_visible : (recipeTrails.flatten.map Row.visible).sum = 40320 := by decide

/-- The saved tuples are bound here to heads of the actual selected trails. -/
theorem recipeTrails_boundaries :
    recipeTrails.map (fun rs => rs.head?.map Row.head) = cutBoundaries.map some := by decide

#print axioms recipeTrails_inventory
#print axioms recipeTrails_closed
#print axioms recipeTrails_boundaries

end SuperpermutationUpperBound.Certificates.NineRecipe
